# 1. Google OAuth 2.0 Client ID (Bắt buộc cho xác thực tài khoản Google & đọc kênh YouTube)
# Tạo tại: Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
# Loại ứng dụng: Web Application
# Authorized JavaScript origins:
#   - http://localhost:5173
#   - http://localhost:3000
#   - https://ananasux.github.io
# Authorized redirect URIs:
#   - http://localhost:5173/
#   - http://localhost:5173/Website_thoitiet_design/
#   - https://ananasux.github.io/Website_thoitiet_design/
VITE_GOOGLE_CLIENT_ID=808045911964-g69d5qp5ou2te9vm173p3o0qnlaqrbfu.apps.googleusercontent.com

# 2. YouTube Data API v3 Key (Tùy chọn cho các truy vấn công khai không cần quyền người dùng)
# Tạo tại: Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> API key
# Bật API: YouTube Data API v3
VITE_YOUTUBE_API_KEY=

# 3. Cloudflare Worker API URL cho News Bot / RSS Feed proxy
VITE_NEWS_BOT_URL=https://new-bot.mrkun28.workers.dev/api/news

# 4. Trạng thái môi trường (development / production)
VITE_APP_ENV=development
